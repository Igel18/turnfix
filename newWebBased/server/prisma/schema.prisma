generator client {
  provider = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pool settings for better resilience
  // Max connections: 20 (adjust based on your PostgreSQL max_connections)
  // Min connections: 2 (keep some connections alive)
  // Connection timeout: 10 seconds
  // Pool timeout: 10 seconds (how long to wait for available connection)
  relationMode = "prisma"
}

model tfx_bereiche {
  int_bereicheid  Int               @id(map: "pkx_bereicheid") @default(autoincrement())
  var_name        String?           @db.VarChar(150)
  bol_maennlich   Boolean?          @default(true)
  bol_weiblich    Boolean?          @default(true)
  tfx_wettkaempfe tfx_wettkaempfe[]
}

model tfx_disgrp_x_disziplinen {
  int_disgrp_x_disziplinenid Int                     @id(map: "pky_disgrp_x_disziplinen") @default(autoincrement())
  int_disziplinen_gruppenid  Int
  int_disziplinenid          Int
  int_pos                    Int?                    @db.SmallInt
  tfx_disziplinen            tfx_disziplinen         @relation(fields: [int_disziplinenid], references: [int_disziplinenid], onDelete: Cascade, onUpdate: Restrict, map: "fky_disziplinen")
  tfx_disziplinen_gruppen    tfx_disziplinen_gruppen @relation(fields: [int_disziplinen_gruppenid], references: [int_disziplinen_gruppenid], onDelete: Cascade, onUpdate: Restrict, map: "fky_disziplinen_gruppenid")
}

model tfx_disziplinen {
  int_disziplinenid             Int                             @id(map: "pky_disziplinenid") @default(autoincrement())
  int_sportid                   Int
  var_name                      String?                         @db.VarChar(100)
  var_kurz1                     String?                         @db.VarChar(6)
  var_kurz2                     String?                         @db.VarChar(20)
  var_formel                    String?                         @db.VarChar(300)
  var_maske                     String?                         @db.VarChar(10)
  int_versuche                  Int?                            @default(1)
  var_icon                      String?                         @db.VarChar(50)
  var_kuerzel                   String?                         @db.VarChar(50)
  int_berechnung                Int?                            @default(2) @db.SmallInt
  var_einheit                   String?                         @db.VarChar(5)
  bol_bahnen                    Boolean?                        @default(false)
  bol_m                         Boolean?                        @default(true)
  bol_w                         Boolean?                        @default(true)
  int_formelid                  Int?
  bol_berechnen                 Boolean?                        @default(true)
  tfx_disgrp_x_disziplinen      tfx_disgrp_x_disziplinen[]
  tfx_formeln                   tfx_formeln?                    @relation(fields: [int_formelid], references: [int_formelid], onDelete: Restrict, onUpdate: Restrict, map: "fky_formelid")
  tfx_sport                     tfx_sport                       @relation(fields: [int_sportid], references: [int_sportid], onUpdate: Restrict, map: "fky_sportid")
  tfx_disziplinen_felder        tfx_disziplinen_felder[]
  tfx_quali_leistungen          tfx_quali_leistungen[]
  tfx_riegen_x_disziplinen      tfx_riegen_x_disziplinen[]
  tfx_startreihenfolge          tfx_startreihenfolge[]
  tfx_wertungen_details         tfx_wertungen_details[]
  tfx_wertungen_x_disziplinen   tfx_wertungen_x_disziplinen[]
  tfx_wettkaempfe_x_disziplinen tfx_wettkaempfe_x_disziplinen[]
}

model tfx_disziplinen_felder {
  int_disziplinen_felderid Int                @id(map: "pky_disziplinen_felderid") @default(autoincrement())
  int_disziplinenid        Int
  var_name                 String?            @db.VarChar(15)
  int_sortierung           Int?               @db.SmallInt
  bol_endwert              Boolean?           @default(true)
  bol_ausgangswert         Boolean?           @default(true)
  int_gruppe               Int?               @default(1) @db.SmallInt
  bol_enabled              Boolean?           @default(true)
  tfx_disziplinen          tfx_disziplinen    @relation(fields: [int_disziplinenid], references: [int_disziplinenid], onDelete: Cascade, onUpdate: Restrict, map: "fky_disziplinenid")
  tfx_jury_results         tfx_jury_results[]
}

model tfx_disziplinen_gruppen {
  int_disziplinen_gruppenid Int                        @id(map: "pky_disziplinen_gruppenid") @default(autoincrement())
  var_name                  String?                    @db.VarChar(100)
