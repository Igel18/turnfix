{
  "name": "turnfix-server",
  "version": "1.0.0",
  "description": "TurnFix Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "prebuild": "node scripts/generate-build-info.js",
    "build": "tsc",
    "build:all": "npm run build && cd ../client && npm run build",
    "start": "node dist/index.js",
    "check-port": "ts-node src/scripts/check-port.ts",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:prod": "npm run build:all && pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop turnfix-server",
    "pm2:restart": "pm2 restart turnfix-server",
    "pm2:reload": "pm2 reload turnfix-server",
    "pm2:delete": "pm2 delete turnfix-server",
    "pm2:logs": "pm2 logs turnfix-server",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:flush": "pm2 flush",
    "pm2:all:start": "pm2 start ecosystem.config.js --only turnfix-server,turnfix-jury-server",
    "pm2:all:stop": "pm2 stop all",
    "pm2:all:restart": "pm2 restart all",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit"
  },
  "dependencies": {
    "@prisma/client": "^5.8.1",
    "@types/multer": "^2.0.0",
    "@types/xml2js": "^0.4.14",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expr-eval": "^2.0.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.4",
    "helmet": "^7.1.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "socket.io": "^4.7.4",
    "xml2js": "^0.6.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^5.2.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "axios": "^1.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "pm2": "^6.0.13",
    "prisma": "^5.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
