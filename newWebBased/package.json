{
  "name": "turnfix-web",
  "version": "1.0.0",
  "description": "Modern gymnastics competition management system",
  "main": "server/dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "db:migrate": "cd server && npm run db:migrate",
    "db:generate": "cd server && npm run db:generate",
    "db:seed": "cd server && npm run db:seed"
  },
  "keywords": ["gymnastics", "competition", "management", "turnfix"],
  "author": "TurnFix Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
