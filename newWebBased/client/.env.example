# TurnFix Client Environment Variables
# Copy this file to .env and update with your network configuration

# API URL for network access
# Replace YOUR_IP_ADDRESS with your actual IP address (e.g., 192.168.1.100)
# VITE_API_URL=http://YOUR_IP_ADDRESS:3001

# For localhost development (default)
# VITE_API_URL=http://localhost:3001

# Example for network access:
# VITE_API_URL=http://192.168.1.100:3001
